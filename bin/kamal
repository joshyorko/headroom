#!/usr/bin/env bash
set -euo pipefail

if kamal_path="$(command -v kamal 2>/dev/null)" && {
  [[ "$kamal_path" != "${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims/"* ]] ||
    mise which kamal >/dev/null 2>&1
}; then
  exec "$kamal_path" "$@"
fi

docker_host="${DOCKER_HOST:-}"
if [[ -n "${DOCKER_CONTEXT:-}" || -z "$docker_host" ]]; then
  docker_host="$(docker context inspect --format '{{.Endpoints.docker.Host}}')"
fi
case "$docker_host" in
  unix://*) docker_socket="${docker_host#unix://}" ;;
  *)
    echo "The Kamal container requires a local Unix Docker socket." >&2
    exit 1
    ;;
esac

exec docker run --rm -it \
  --network host \
  -v "$PWD:/work" \
  -v "$HOME/.ssh:/root/.ssh:ro" \
  -v "$docker_socket:/var/run/docker.sock" \
  -w /work \
  ghcr.io/basecamp/kamal:latest "$@"
